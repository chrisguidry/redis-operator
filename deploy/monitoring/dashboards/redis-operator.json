{
  "title": "redis-operator",
  "uid": "redis-operator",
  "schemaVersion": 42,
  "editable": true,
  "tags": [
    "redis"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "type": "query",
        "name": "namespace",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(redis_up{redis!=\"\"}, namespace)",
          "refId": "namespace"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "type": "query",
        "name": "redis",
        "label": "Redis",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(redis_up{namespace=~\"$namespace\", redis!=\"\"}, redis)",
          "refId": "redis"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Instances",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "table",
      "title": "Role per instance",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "redis_role is the label the operator writes on each pod. role is the server's own view from INFO. They disagree for a few seconds during a switchover or a failover. In replica mode the primary is a replica of its source, so its role reads slave.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Up"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "down",
                        "color": "red"
                      },
                      "1": {
                        "text": "up",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "pod"
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "namespace": 0,
              "redis": 1,
              "pod": 2,
              "redis_role": 3,
              "role": 4,
              "redis_version": 5,
              "Value": 6
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "instant": true,
          "format": "table",
          "expr": "max by (namespace, redis, pod, redis_role) (redis_up{namespace=~\"$namespace\", redis=~\"$redis\"}) * on (namespace, pod) group_left (role, redis_version) max by (namespace, pod, role, redis_version) (redis_instance_info{namespace=~\"$namespace\", redis=~\"$redis\"})"
        }
      ],
      "id": 2
    },
    {
      "type": "row",
      "title": "Load",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Commands per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pod) (rate(redis_commands_processed_total{namespace=~\"$namespace\", redis=~\"$redis\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Connected clients",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pod) (redis_connected_clients{namespace=~\"$namespace\", redis=~\"$redis\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Memory used and maxmemory",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pod) (redis_memory_used_bytes{namespace=~\"$namespace\", redis=~\"$redis\"})",
          "legendFormat": "{{pod}} used"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "max by (redis) (redis_memory_max_bytes{namespace=~\"$namespace\", redis=~\"$redis\"})",
          "legendFormat": "{{redis}} maxmemory"
        }
      ],
      "description": "maxmemory is the share of spec.memory the server may fill with data. With noeviction, writes that need memory fail once used reaches it.",
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Single keys",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (redis, db, key) (redis_key_size{namespace=~\"$namespace\", redis=~\"$redis\", redis_role=\"primary\"})",
          "legendFormat": "{{redis}} {{db}} {{key}}"
        }
      ],
      "description": "The length or size of each key that spec.metrics.checkSingleKeys names, read on the primary.",
      "id": 7
    },
    {
      "type": "row",
      "title": "Replication",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Replication offset",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (pod) (redis_master_repl_offset{namespace=~\"$namespace\", redis=~\"$redis\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "description": "Each instance's replication offset. A replica that keeps pace draws the same line as its primary.",
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Replica lag behind the primary",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (namespace, redis) (redis_master_repl_offset{namespace=~\"$namespace\", redis=~\"$redis\", redis_role=\"primary\"}) - on (namespace, redis) group_right max by (namespace, redis, pod) (redis_master_repl_offset{namespace=~\"$namespace\", redis=~\"$redis\", redis_role=\"replica\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "description": "The primary's offset minus each replica's.",
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Seconds since each replica's acknowledgement",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (pod, slave_ip) (redis_connected_slave_lag_seconds{namespace=~\"$namespace\", redis=~\"$redis\"})",
          "legendFormat": "{{pod}} to {{slave_ip}}"
        }
      ],
      "description": "Read on the primary. A replica acknowledges every second, and min-replicas-max-lag stops counting one that goes longer.",
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Replication link",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "bool_yes_no"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "min by (pod) (redis_master_link_up{namespace=~\"$namespace\", redis=~\"$redis\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "description": "1 while a replica's link to its primary is up. Every replica detaches while a failover picks the next primary.",
      "id": 12
    },
    {
      "type": "row",
      "title": "Operator",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Failovers and switchovers",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(increase(redis_operator_failovers_total{job=\"redis-operator\"}[$__rate_interval]))",
          "legendFormat": "failover"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum by (reason) (increase(redis_operator_switchovers_total{job=\"redis-operator\"}[$__rate_interval]))",
          "legendFormat": "switchover: {{reason}}"
        }
      ],
      "description": "Counted across every Redis the operator runs; the operator's log names each one.",
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Leader and reconcile errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (pod) (redis_operator_leader{job=\"redis-operator\"})",
          "legendFormat": "{{pod}} leads"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum(rate(redis_operator_reconcile_errors_total{job=\"redis-operator\"}[$__rate_interval]))",
          "legendFormat": "reconcile errors per second"
        }
      ],
      "id": 15
    }
  ]
}
